# Remote host where the dedicated Kaia RPC node will run.
MBP_HOST=mbp.local
MBP_USER=odonghwan
MBP_PORT=22

# Local path on the MBP where Kaia packages will be extracted.
KAIA_INSTALL_DIR=/Users/odonghwan/kaia-service-rpc
KAIA_DATA_DIR=/Users/odonghwan/kaia-service-rpc/data
KAIA_LOG_DIR=/Users/odonghwan/kaia-service-rpc/logs

# Existing lab peer list indicates a CN/PN-backed chain, so EN is the default.
# Allowed values: EN, SEN
KAIA_NODE_KIND=EN

# Existing lab chain bootstrap materials.
# These must come from the lab network operator.
LAB_GENESIS_JSON=/path/to/genesis.json
LAB_STATIC_NODES_JSON=/path/to/static-nodes.json

# If the lab chain already assigned a dedicated nodekey for the MBP RPC node, set it.
LAB_NODEKEY=/path/to/nodekey

# Network identity.
# As of the 2026-04-08 lab testnet restart, the current chain/network id is 4669126.
NETWORK_ID=4669126
P2P_PORT=32323
RPC_PORT=8551
WS_PORT=8552

# Internal-only bind address is recommended.
RPC_ADDR=0.0.0.0
WS_ADDR=0.0.0.0
RPC_VHOSTS=*
RPC_CORSDOMAIN=*
WS_ORIGINS=*

# Conservative public-RPC modules for HyperL2 tooling.
RPC_API=eth,kaia,net,rpc,web3,txpool
WS_API=eth,kaia,net,rpc,web3,txpool

# Optional: if you decide to expose debug APIs only on a private network.
ENABLE_DEBUG=0
